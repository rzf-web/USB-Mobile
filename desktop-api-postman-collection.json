        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Verifikasi email dan password customer ke database utama (db_rzfmember). Mengembalikan ID Customer dan nama database tenant dinamis.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"contoh@email.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": []
