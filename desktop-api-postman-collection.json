            "description": "Mengubah data setoran (action: 'update_submit') atau menghapus setoran gaji (action: 'delete_submit'). Jumlah finish pada tb_btk akan otomatis disesuaikan/dikurangi kembali.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 2500,\n  \"kerja\": \"Jahit\",\n  \"action\": \"update_submit\",\n  \"idgaji\": \"260913123000123\",\n  \"jumlah\": 12,\n  \"status\": \"Belum Lunas\",\n  \"idpegawai\": \"PG001\"\n}",
              "options": {
