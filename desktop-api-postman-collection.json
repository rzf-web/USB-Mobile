              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "konveksi",
                "employee-work"
              ]
            },
            "description": "Mengubah rincian (action: 'update_order') atau membatalkan/menghapus order pekerjaan yang belum disetor (action: 'delete_order'). Jika barcode dikosongkan pada delete_order, seluruh pekerjaan aktif proyek tersebut akan dihapus.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"nama\": \"Kaos Hitam L\",\n      \"harga\": 2500,\n      \"jumlah\": 15,\n      \"barcode\": \"8999999999999\"\n    }\n  ],\n  \"kerja\": \"Jahit\",\n  \"action\": \"update_order\",\n  \"idproyek\": \"PRJ001\",\n  \"idpegawai\": \"PG001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
